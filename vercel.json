{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/health-insurance", "destination": "/health-insurance/index.html" },
    { "source": "/health-insurance/(.*)", "destination": "/health-insurance/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
