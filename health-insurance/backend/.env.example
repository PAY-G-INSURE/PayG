# Copy to .env for local development. Never commit real values.
# Each environment (local, staging, production) uses its own Supabase project and keys.

# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Supabase ─────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API. The service role key is server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── JWT ──────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# ─── Admin ────────────────────────────────────────────────
# node -e "console.log(require('bcryptjs').hashSync('choose-a-long-password', 12))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated origins; `*` matches one subdomain label.
# Production: https://payg-health.netlify.app
# Staging:    https://develop--payg-health.netlify.app,https://*--payg-health.netlify.app
FRONTEND_URL=http://localhost:5174

# ─── Paystack ─────────────────────────────────────────────
# sk_test_ everywhere except production.
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# ─── OTP ──────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10

# ─── Africa's Talking ─────────────────────────────────────
# Use the sandbox username/key outside production.
AT_API_KEY=your-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=
AT_USSD_CALLBACK_TOKEN=replace-with-a-long-random-token
